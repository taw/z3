#!/usr/bin/env ruby

require "pathname"

if ARGV.empty?
  STDERR.puts "Usage: #{$0} file1.h file2.h ..."
  exit 1
end

def_lines = ARGV.flat_map{|path| Pathname(path).readlines}.map(&:strip).grep(/def_API/)

# uniq because the same entry point can be declared in more than one header
output =  def_lines.map{|line| line.gsub(/def_API\s+/, "def_API")+"\n"}.uniq.sort.join

Pathname("#{__dir__}/definitions.h").write(output)
