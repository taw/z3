#!/usr/bin/env ruby

require "pathname"
require_relative "definition"
require "set"

class GenerateAPI
  def initialize(*paths)
    @definitions = []
    paths.each do |path|
      add_file! Pathname(path)
    end
  end

  def run!
    (Pathname(__dir__) + "../lib/z3/very_low_level_auto.rb").open("w") do |fh|
      fh.puts "module Z3"
      fh.puts "  module VeryLowLevel"
      fh.puts supported_definitions.map(&:ffi).join("\n")
      fh.puts "  end"
      fh.puts "end"
    end

    (Pathname(__dir__) + "../lib/z3/low_level_auto.rb").open("w") do |fh|
      fh.puts "module Z3"
      fh.puts "  module LowLevel"
      fh.puts "    class << self"
      fh.puts supported_definitions.map(&:api).join("\n")
      fh.puts "    end"
      fh.puts "  end"
      fh.puts "end"
    end
  end

  def definitions_to_skip
    @definitions_to_skip ||= begin
      [
        # Only meaningful with more than one context, and one context is all there is -
        # `Context` is a hard-coded singleton and multiple contexts are explicitly out
        # of scope. `translate` and friends move an object between two of them,
        # `import_model_converter` is how a translated solver carries its model
        # conversion across, and `mk_context_rc` builds the other kind of context.
        "ast_vector_translate",
        "goal_translate",
        "mk_context_rc",
        "model_translate",
        "optimize_translate",
        "solver_import_model_converter",
        "solver_translate",
        "translate",

        # Sort predicates - `Sort.from_pointer` dispatches on the sort kind instead
        "is_string_sort",
        "is_string",
        "is_re_sort",
        "is_seq_sort",

        # Just C type casts, not needed
        "to_app",
        "to_func_decl",
        "pattern_to_ast",
        "sort_to_ast",
        "func_decl_to_ast",
        "app_to_ast",

        # Aliases, so we keep whichever spelling the object layer already uses.
        # Pattern, Sort and FuncDecl are all ASTs to the C API, so the three
        # `*_to_string` are `ast_to_string` with a differently typed pointer; the header
        # says outright that `get_arity` is an alias for `get_domain_size`; and the
        # `mk_fpa_r*` five are the short spellings of `mk_fpa_round_*`.
        "func_decl_to_string",
        "get_domain_size",
        "mk_fpa_rna",
        "mk_fpa_rne",
        "mk_fpa_rtn",
        "mk_fpa_rtp",
        "mk_fpa_rtz",
        "pattern_to_string",
        "sort_to_string",

        # We just unpack and throw away, so we shouldn't need these. Statistics become
        # a Hash, an AstVector becomes an Array, and a FuncInterp becomes a Hash whose
        # keys are argument lists - so nothing here ever holds one of these objects,
        # prints it, or writes back into it.
        # (`func_interp_add_entry` and `func_interp_set_else` are deliberately absent:
        # those write a model rather than read one, and `Model.new(Hash)` does that -
        # through `LowLevel.pack_func_interp`, which uses the first of the two.
        # `func_interp_set_else` stays bound and unused, as `add_func_interp` takes the
        # else value up front and a model built here is built once.)
        "ast_vector_resize",
        "ast_vector_set",
        "ast_vector_to_string",
        "func_interp_get_arity",
        "stats_dec_ref",
        "stats_inc_ref",
        "stats_to_string",

        # Extra constructors we'll never need
        "mk_fpa_numeral_float",

        # Hand-coded
        "mk_add",
        "mk_and",
        "mk_distinct",
        "mk_mul",
        "mk_or",
        "mk_seq_concat",
        "mk_set_intersect",
        "mk_set_union",
        "mk_sub",
        "get_string",
        "get_version",
      ] + (Pathname(__dir__) + "../lib/z3/low_level.rb").read.scan(/^\s+def \K\w+/)
    end.to_set
  end

  def supported_definitions
    @supported_definitions ||= begin
      @definitions
        .reject { |d| definitions_to_skip.include?(d.name) }
        .select(&:supported?)
        .sort
    end
  end

  private

  def add_definition!(definition)
    begin
      @definitions << Definition.new(definition)
    rescue
      # skip, it's some new API
      warn "#{$!}"
    end
  end

  def add_file!(path)
    path.readlines.grep(/def_API/).map(&:strip).each do |definition|
      add_definition! definition
    end
  end
end

if ARGV.empty?
  STDERR.puts "Usage: #{$0} path1.h path2.h [...]"
  exit 1
end

GenerateAPI.new(*ARGV).run!
